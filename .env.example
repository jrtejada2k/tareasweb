# ============================================
# TasksWeb Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# NEVER commit .env file to version control

# ============================================
# Application Environment
# ============================================
NODE_ENV=production
API_PORT=3000
FRONTEND_URL=http://localhost

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_DB=tareasweb
POSTGRES_USER=tareasweb_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_MIN_16_CHARS
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Database connection pool settings (optimized for 1GB RAM)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ============================================
# JWT Authentication
# ============================================
# Generate secure random strings (min 32 characters):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=CHANGE_ME_GENERATE_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_SECURE_RANDOM_STRING_MIN_32_CHARS

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Password Hashing
# ============================================
# bcrypt cost factor (10-12 recommended, higher = more secure but slower)
BCRYPT_ROUNDS=10

# ============================================
# Rate Limiting
# ============================================
# Login attempts per IP
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m

# General API rate limit
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=15m

# ============================================
# Email Configuration (for alerts and notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=TasksWeb <noreply@yourdomain.com>

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/tareasweb/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7d

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost,https://yourdomain.com
CORS_CREDENTIALS=true

# ============================================
# Session Configuration
# ============================================
SESSION_SECRET=CHANGE_ME_ANOTHER_SECURE_RANDOM_STRING

# ============================================
# Alerts Configuration
# ============================================
# Percentage of time remaining to trigger "at risk" alerts
ALERT_THRESHOLD_NOT_STARTED=50
ALERT_THRESHOLD_IN_PROGRESS=20

# Email alert frequency (daily, hourly)
ALERT_EMAIL_FREQUENCY=daily

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/var/backups/tareasweb

# ============================================
# Feature Flags
# ============================================
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_TIME_TRACKING=true

# ============================================
# Development Only (remove in production)
# ============================================
# Uncomment for development mode
# NODE_ENV=development
# LOG_LEVEL=debug
# DATABASE_LOGGING=true
